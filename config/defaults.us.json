{
  "broker": "schwab",
  "market": "us",
  "index": "sp500",
  "method": "us_quality_momentum",
  "top_n": 20,
  "range": "1y",
  "pipeline_config": "config/pipeline_us.yaml",
  "logging": {
    "dir": "data/logs",
    "level": "info",
    "file": true,
    "retain_days": 14
  },
  "edgar": {
    "enabled": true,
    "user_agent": "mycase/1.0 (gkgarg24@yahoo.com)",
    "facts_ttl_days": 80,
    "cik_ttl_days": 7
  },
  "raw": {
    "retain_days": 14,
    "max_size_mb": 512
  },
  "scheduler": {
    "enable_eod": true,
    "enable_drift": true,
    "enable_rebalance": true,
    "close_offset_min": 15,
    "max_run_min": 20,
    "fail_alert_after": 3,
    "enable_report": true,
    "report_path": ""
  }
}
