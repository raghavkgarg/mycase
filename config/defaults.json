{
  "broker": "zerodha",
  "market": "india",
  "index": "niftytotalmarket",
  "method": "multibagger",
  "top_n": 20,
  "range": "3mo",
  "pipeline_config": "config/pipeline.yaml",
  "logging": {
    "dir": "data/logs",
